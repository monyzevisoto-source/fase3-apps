DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
PORT=8001
MASTER_KEY=replace-with-a-local-development-secret

# Traces para New Relic (OTLP HTTP/protobuf). Use sua ingest license key.
# Apenas traces: mantém o destino existente de logs e métricas.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp.nr-data.net:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_HEADERS=api-key=replace-with-new-relic-ingest-license-key
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_TRACES_EXPORTER=none
