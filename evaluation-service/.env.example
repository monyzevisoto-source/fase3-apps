PORT=8004
REDIS_URL=redis://localhost:6379
FLAG_SERVICE_URL=http://localhost:8002
TARGETING_SERVICE_URL=http://localhost:8003
SERVICE_API_KEY=replace-with-a-local-development-api-key
AWS_SQS_URL=https://sqs.<region>.amazonaws.com/<account>/<queue>
AWS_REGION=us-east-1

# Traces para New Relic (OTLP HTTP/protobuf). Use sua ingest license key.
# Apenas traces: mantém o destino existente de logs e métricas.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otlp.nr-data.net:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_HEADERS=api-key=replace-with-new-relic-ingest-license-key
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_TRACES_EXPORTER=none
